rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read and write their own user profile
    // Also allow reading other user profiles for search functionality
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        // User can update their own profile except verification status
        (request.auth.uid == userId &&
          !("kycStatus" in request.resource.data.roleSpecificData.artistData.keys() ||
            "skillStatus" in request.resource.data.roleSpecificData.artistData.keys()))
        // Admin can update any field
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
      allow create: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to read and write their own data
    match /availability/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /portfolios/{documentId} {
      allow read: if request.auth != null;
      allow write, create: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /pricing/{documentId} {
      allow read: if request.auth != null;
      allow write, create: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /bookings/{bookingId} {
      allow read, write: if request.auth != null && 
        (resource.data.clientId == request.auth.uid || 
         resource.data.artistId == request.auth.uid);
      allow create: if request.auth != null;
    }
    
    // Allow reading vendor listings for all authenticated users
    match /vendors/{vendorId} {
      allow read: if request.auth != null;
      allow write, create: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Allow reading/writing messages for participants
    match /messages/{messageId} {
      allow read, write: if request.auth != null && 
        (resource.data.senderId == request.auth.uid || 
         resource.data.receiverId == request.auth.uid);
      allow create: if request.auth != null;
    }
    
    // Allow reading/writing events and productions
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && resource.data.organizerId == request.auth.uid;
      allow create: if request.auth != null;
    }

    match /productions/{productionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && resource.data.productionHouseId == request.auth.uid;
      allow create: if request.auth != null;
    }

    // Community Feed: Only artists can post, all can read, only owner can delete
    match /community_posts/{postId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'artist' &&
        request.resource.data.artistId == request.auth.uid;
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/community_posts/$(postId)).data.artistId == request.auth.uid;
    }
  }
}